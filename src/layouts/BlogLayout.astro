---
const { frontmatter } = Astro.props;
---
<!DOCTYPE html>
<html lang={frontmatter.lang || "en"}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{frontmatter.title} | Clarinbridge Publishing</title>
    <meta name="description" content={frontmatter.description}>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --green: #0e380e;
            --gold: #C2B280;
            --gold-light: #d9cda0;
            --cream: #faf8f4;
            --ink: #1a1a1a;
            --muted: #6b6b6b;
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Lora', Georgia, serif;
            background-color: var(--cream);
            color: var(--ink);
            line-height: 1.8;
            -webkit-font-smoothing: antialiased;
        }

        .serif { font-family: 'Playfair Display', Georgia, serif; }

        /* ── HEADER ── */
        header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            background: rgba(250, 248, 244, 0.96);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(194,178,128,0.25);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        header a.logo {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: var(--green);
            text-decoration: none;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            font-weight: 700;
        }

        header a.back {
            font-family: 'Lora', serif;
            font-size: 0.75rem;
            color: var(--muted);
            text-decoration: none;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            border-bottom: 1px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }
        header a.back:hover { color: var(--green); border-color: var(--gold); }

        /* ── HERO BAND ── */
        .hero-band {
            margin-top: 64px;
            background: var(--green);
            padding: 4rem 2rem 3.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }



        .hero-band .eyebrow {
            font-family: 'Lora', serif;
            font-size: 0.7rem;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1.25rem;
            position: relative;
        }

        .hero-band h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.75rem, 4vw, 3rem);
            font-weight: 700;
            color: #fff;
            line-height: 1.25;
            max-width: 780px;
            margin: 0 auto 1.5rem;
            position: relative;
        }

        .hero-band .description {
            font-family: 'Lora', serif;
            font-style: italic;
            color: rgba(255,255,255,0.65);
            font-size: 1rem;
            max-width: 560px;
            margin: 0 auto;
            position: relative;
        }

        .gold-rule {
            width: 48px;
            height: 2px;
            background: var(--gold);
            margin: 1.5rem auto 0;
            position: relative;
        }

        /* ── ARTICLE BODY ── */
        .article-wrap {
            max-width: 720px;
            margin: 0 auto;
            padding: 4rem 2rem 6rem;
        }

        /* Markdown content styling */
        .article-body p {
            font-size: 1.0625rem;
            line-height: 1.85;
            color: #2c2c2c;
            margin-bottom: 1.5rem;
        }

        .article-body h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--green);
            margin: 3rem 0 1rem;
            line-height: 1.3;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid rgba(194,178,128,0.3);
        }

        .article-body h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--ink);
            margin: 2rem 0 0.75rem;
        }

        .article-body ul, .article-body ol {
            padding-left: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .article-body li {
            font-size: 1.0625rem;
            line-height: 1.8;
            color: #2c2c2c;
            margin-bottom: 0.5rem;
        }

        .article-body li strong {
            color: var(--green);
            font-weight: 600;
        }

        .article-body a {
            color: var(--green);
            text-decoration: underline;
            text-decoration-color: var(--gold);
            text-underline-offset: 3px;
            transition: color 0.2s;
        }
        .article-body a:hover { color: var(--gold); }

        .article-body strong {
            font-weight: 600;
            color: var(--ink);
        }

        .article-body hr {
            border: none;
            border-top: 1px solid rgba(194,178,128,0.4);
            margin: 3rem 0;
        }

        /* Pull quote / blockquote style for the verdict section */
        .article-body blockquote {
            border-left: 3px solid var(--gold);
            margin: 2rem 0;
            padding: 1rem 1.5rem;
            background: rgba(194,178,128,0.07);
            border-radius: 0 4px 4px 0;
        }

        .article-body blockquote p {
            font-style: italic;
            color: var(--muted);
            margin-bottom: 0;
        }

        /* ── CTA BAND ── */
        .cta-band {
            background: var(--green);
            text-align: center;
            padding: 4rem 2rem;
        }

        .cta-band p {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            color: #fff;
            margin-bottom: 1.75rem;
            font-style: italic;
        }

        .cta-band a {
            display: inline-block;
            background: var(--gold);
            color: #fff;
            text-decoration: none;
            font-family: 'Lora', serif;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            padding: 1rem 2.5rem;
            border-radius: 3px;
            transition: background 0.2s, transform 0.2s;
        }
        .cta-band a:hover { background: #b0a070; transform: translateY(-1px); }

        /* ── FOOTER ── */
        footer {
            background: #071f07;
            color: rgba(255,255,255,0.5);
            text-align: center;
            padding: 2.5rem 1rem;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
        }

        footer .brand {
            font-family: 'Playfair Display', serif;
            color: rgba(255,255,255,0.8);
            font-size: 0.85rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        @media (max-width: 640px) {
            .hero-band { padding: 3rem 1.25rem 2.5rem; }
            .article-wrap { padding: 2.5rem 1.25rem 4rem; }
            header { padding: 0.875rem 1.25rem; }
        }
    </style>
</head>
<body>

<header>
    <a href="/" class="logo">Clarinbridge Publishing</a>
    <a href="/" class="back">← Back to Home</a>
</header>

<div class="hero-band">
    <p class="eyebrow">Publishing Guide · 2026</p>
    <h1>{frontmatter.title}</h1>
    <p class="description">{frontmatter.description}</p>
    <div class="gold-rule"></div>
</div>

<div class="article-wrap">
    <article class="article-body">
        <slot />
    </article>
</div>

<div class="cta-band">
    <p>Ready to publish your book the right way?</p>
    <a href="/#pricing">Get Your ISBN Today</a>
</div>

<footer>
    <p class="brand">Clarinbridge Publishing</p>
    <p>© 2026 Clarinbridge Publishing Services. All Rights Reserved.</p>
</footer>

</body>
</html>